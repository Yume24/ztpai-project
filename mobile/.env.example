# Adres backendu. 10.0.2.2 to adres komputera widziany z emulatora Androida.
# Dla telefonu w tej samej sieci wpisz adres IP komputera, np. http://192.168.0.10:8080.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Klucz Google Maps SDK dla Androida (mapa w pełnym buildzie).
GOOGLE_MAPS_API_KEY=

# Identyfikator projektu EAS (potrzebny do tokenów push i buildów w chmurze).
EAS_PROJECT_ID=

# Ścieżka do google-services.json z Firebase (powiadomienia push FCM na Androidzie).
GOOGLE_SERVICES_JSON=
